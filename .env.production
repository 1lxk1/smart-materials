# =============================================================================
#  生产构建环境变量（npm run build 时自动加载）
#
#  ⚠️ 占位域名提醒（部署前必须改）
#     下面两个地址目前是「示例域名」，并不真实存在：
#       VITE_API_BASE_URL     = https://smart-materials-api.onrender.com/api
#       VITE_PUBLIC_BASE_URL  = https://smart-materials.vercel.app
#     真实部署后请替换为你自己的 Render 服务地址 / Vercel 域名，否则：
#       · 前端所有接口都会 404 / CORS 失败；
#       · 批次二维码里写死的 /login?redirect=/outbound&batchCode=... 会指向不存在的站点。
#     更稳的做法：在 Vercel → Settings → Environment Variables 里配置同名变量，
#     平台环境变量优先级高于本文件。
#
#  ⚠️ Vite 环境变量是「构建时」打进 JS 的，改完必须重新 build 才生效。
# =============================================================================

VITE_APP_TITLE=材智通·智慧材料库

# 后端地址：Render 部署完成后填自己的服务地址（必须以 /api 结尾）
VITE_API_BASE_URL=https://smart-materials-api.onrender.com/api

# 前端对外域名：二维码会拼成 ${VITE_PUBLIC_BASE_URL}/login?redirect=/outbound&batchCode=xxx
VITE_PUBLIC_BASE_URL=https://smart-materials.vercel.app

# 关闭 Mock：所有数据走真实后端接口
VITE_USE_MOCK=false

# LDAP：当前版本后端只用 sys_user 本地密码校验（BCrypt），LDAP 绑定为二期功能。
# 打开此开关只会影响登录页的文案提示，不会真的走 LDAP 认证。
VITE_LDAP_ENABLED=false
