# 后端环境变量模板（复制为 .env 或者直接在 Render 面板里逐条填写）
# 注意：Spring Boot 会自动把环境变量按“点号 → 下划线”的规则覆盖 application.yml

# ---------- 服务 ----------
PORT=8080

# ---------- PostgreSQL 15 ----------
# 方式 A（推荐，Render 内网 Database URL 拆开填）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_materials
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=prefer

# 方式 B：直接给完整 JDBC URL（优先级高于上面的拆分变量）
# SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/smart_materials?sslmode=require

# ---------- JWT ----------
# 至少 32 个字符，生产务必替换
JWT_SECRET=please-change-me-to-a-32-chars-random-secret
JWT_EXPIRE_MINUTES=720

# ---------- CORS ----------
# 前后端分离：填 Vercel 前端域名，多个用逗号分隔；* 表示全部放开
CORS_ALLOWED_ORIGINS=*

# ---------- 初始化 ----------
# always=每次启动都执行 schema.sql/data.sql（脚本幂等）；建好表后可改 never
SQL_INIT_MODE=always
SEED_DATA=true
# 种子账号初始密码（admin/lab01/stu2024001/teacher01/buyer01）
SEED_PASSWORD=123456
