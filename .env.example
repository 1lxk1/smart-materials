# 前端环境变量模板（复制为 .env.local 使用）
# 注意：Vite 环境变量是构建时注入的，改完要重新 build。
# 生产环境（Vercel）请在平台面板配置同名变量，不要提交真实密钥。

VITE_APP_TITLE=材智通·智慧材料库

# 后端接口地址（本地开发默认 8080）
VITE_API_BASE_URL=http://localhost:8080/api

# 前端对外域名：批次二维码内容 = ${VITE_PUBLIC_BASE_URL}/login?redirect=/outbound&batchCode=xxx
VITE_PUBLIC_BASE_URL=http://localhost:5173

# 关闭 Mock，走真实后端
VITE_USE_MOCK=false

VITE_LDAP_ENABLED=false
