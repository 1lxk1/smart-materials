# 前端多阶段构建：Node 编译 -> Nginx 托管静态产物
# 构建上下文是项目根目录（不是 deploy/）：docker build -f deploy/Dockerfile.frontend .
FROM node:22-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# 构建期注入接口地址（会覆盖 .env.production，需改域名时在这里传参）
ARG VITE_API_BASE_URL=/api
ARG VITE_USE_MOCK=false
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
